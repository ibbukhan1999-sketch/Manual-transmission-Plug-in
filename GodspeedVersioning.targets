<Project>
  <Target Name="StampGodspeedVersion"
          BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)Stamp-GodspeedVersion.ps1&quot; -ProjectDirectory &quot;$(MSBuildProjectDirectory)&quot; -ProjectName &quot;$(MSBuildProjectName)&quot;" />
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\obj\godspeed-build-day.txt">
      <Output TaskParameter="Lines" PropertyName="GodspeedBuildDay" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\obj\godspeed-build-sequence.txt">
      <Output TaskParameter="Lines" PropertyName="GodspeedBuildSequence" />
    </ReadLinesFromFile>
    <ReadLinesFromFile File="$(MSBuildProjectDirectory)\obj\godspeed-build-utc.txt">
      <Output TaskParameter="Lines" PropertyName="GodspeedBuildUtc" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <Version>$(VersionPrefix)</Version>
      <AssemblyVersion>$(GodspeedMajor).$(GodspeedMinor).$(GodspeedBuildDay).$(GodspeedBuildSequence)</AssemblyVersion>
      <FileVersion>$(AssemblyVersion)</FileVersion>
      <InformationalVersion>$(VersionPrefix)+build.$(GodspeedBuildDay).$(GodspeedBuildSequence).$(GodspeedBuildUtc)</InformationalVersion>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>GodspeedBuildUtc</_Parameter1>
        <_Parameter2>$(GodspeedBuildUtc)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <Target Name="ReportGodspeedBuildVersion"
          AfterTargets="Build"
          BeforeTargets="GodspeedPluginAutoDeploy"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(GodspeedBuildSequence)' != ''">
    <Message Importance="high"
             Text="Godspeed $(MSBuildProjectName): $(InformationalVersion) | Assembly/File $(AssemblyVersion) | UTC $(GodspeedBuildUtc) | Artifact $(TargetPath)" />
  </Target>
</Project>
