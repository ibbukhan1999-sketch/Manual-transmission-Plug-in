<Project Sdk="Microsoft.NET.Sdk.Razor" InitialTargets="ValidateBuildDependencies">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>ManualTransmission</AssemblyName>
    <RootNamespace>Godspeed</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <NuGetAudit>true</NuGetAudit>
    <GodspeedMajor>2</GodspeedMajor>
    <GodspeedMinor>1</GodspeedMinor>
    <GodspeedPatch>0</GodspeedPatch>
    <VersionPrefix>$(GodspeedMajor).$(GodspeedMinor).$(GodspeedPatch)</VersionPrefix>
    <Deterministic>true</Deterministic>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ETS2LASourceRoot Condition="'$(ETS2LASourceRoot)' == ''">$(ETS2LA_SOURCE_ROOT)</ETS2LASourceRoot>
    <GodspeedSharedPath Condition="'$(GodspeedSharedPath)' == '' and '$(LocalAppData)' != ''">$(LocalAppData)\ETS2LA\current\Libraries\Godspeed.Shared.dll</GodspeedSharedPath>
  </PropertyGroup>

  <Target Name="ValidateBuildDependencies">
    <Error Condition="'$(ETS2LASourceRoot)' == ''"
           Text="Set ETS2LASourceRoot to a compatible ETS2LA source checkout." />
    <Error Condition="'$(ETS2LASourceRoot)' != '' and !Exists('$(ETS2LASourceRoot)\ETS2LA.Game\ETS2LA.Game.csproj')"
           Text="ETS2LASourceRoot does not contain ETS2LA.Game\ETS2LA.Game.csproj." />
    <Error Condition="'$(GodspeedSharedPath)' == '' or !Exists('$(GodspeedSharedPath)')"
           Text="Provide Godspeed.Shared.dll with -p:GodspeedSharedPath=&lt;full path&gt;, or install it in ETS2LA's Libraries folder." />
  </Target>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Build.Tasks.Git" Version="10.0.401" PrivateAssets="all" />
    <Reference Include="Godspeed.Shared">
      <HintPath>$(GodspeedSharedPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <EmbeddedResource Include="$(GodspeedSharedPath)" LogicalName="Godspeed.Shared.dll"
                      Condition="Exists('$(GodspeedSharedPath)')" />
    <ProjectReference Include="$(ETS2LASourceRoot)\ETS2LA.Shared\ETS2LA.Shared.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(ETS2LASourceRoot)\ETS2LA.Backend\ETS2LA.Backend.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(ETS2LASourceRoot)\ETS2LA.Game\ETS2LA.Game.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(ETS2LASourceRoot)\ETS2LA.Logging\ETS2LA.Logging.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(ETS2LASourceRoot)\ETS2LA.Overlay\ETS2LA.Overlay.csproj">
      <Private>false</Private>
    </ProjectReference>
    <ProjectReference Include="$(ETS2LASourceRoot)\ETS2LA.State\ETS2LA.State.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>
  <Import Project="GodspeedVersioning.targets" />

  <Target Name="DeployManualTransmissionOutputs"
          AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT' and '$(DesignTimeBuild)' != 'true'
            and '$(GodspeedDeploymentInProgress)' != 'true'">
    <Error Condition="'$(LocalAppData)' == ''" Text="LocalAppData is required to deploy ManualTransmission." />
    <MakeDir Directories="$(LocalAppData)\ETS2LA\current\Plugins" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(LocalAppData)\ETS2LA\current\Plugins\$(AssemblyName).dll"
          OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb"
          DestinationFiles="$(LocalAppData)\ETS2LA\current\Plugins\$(AssemblyName).pdb"
          Condition="Exists('$(TargetDir)$(AssemblyName).pdb')"
          OverwriteReadOnlyFiles="true" />
  </Target>
</Project>
